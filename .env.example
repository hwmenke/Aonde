# =============================================================================
# aonde-affiliates — variaveis de ambiente (exemplo)
# Copie este arquivo para ".env" na raiz de aonde-affiliates/ e preencha os
# valores. NUNCA faca commit do arquivo ".env" real (credenciais reais).
# Todos os campos abaixo estao propositalmente em branco.
# =============================================================================

# -----------------------------------------------------------------------------
# TRAVELPAYOUTS (Aviasales / Kiwi / Hotellook / WayAway)
# Cadastro: https://www.travelpayouts.com/ -> crie conta -> Profile -> API token
# O "marker" (Partner ID) tambem aparece no seu perfil, apos aderir as marcas
# (brands) desejadas. Sem token nao ha acesso a Data API; sem marker nao ha
# como montar links de afiliado (nem via template tp.media, nem via API).
# -----------------------------------------------------------------------------
TRAVELPAYOUTS_TOKEN=
TRAVELPAYOUTS_MARKER=

# -----------------------------------------------------------------------------
# AWIN (rede de afiliados que hospeda Decolar.com e outras OTAs)
# Token OAuth2 pessoal: criado em https://ui.awin.com/awin-api (apos sua conta
# de publisher ser aprovada na rede Awin).
# Publisher ID: aparece no seu painel Awin (ui.awin.com), no topo/URL do painel.
# Advertiser ID da Decolar: aparece na pagina do programa da Decolar dentro do
# Awin, depois de voce aderir ("join") ao programa do anunciante. Sem estar
# aprovado no programa do anunciante, os links gerados nao geram comissao.
# -----------------------------------------------------------------------------
AWIN_API_TOKEN=
AWIN_PUBLISHER_ID=
AWIN_ADVERTISER_ID_DECOLAR=

# -----------------------------------------------------------------------------
# HURB / CLUBE HURB
# NAO HA API PUBLICA. Cadastre-se em https://www.clubehu.com.br/, aguarde a
# aprovacao por e-mail e, no painel do afiliado, use a opcao "Traquear URL"
# para gerar manualmente o link rastreavel da oferta desejada. Cole aqui o
# link ja traqueado (o modulo apenas repassa esse link; ele NAO gera links
# novos para o Hurb).
# -----------------------------------------------------------------------------
HURB_TRACKED_LINK=

# HURB_TRACKED_LINKS_JSON (opcional): como cada link e gerado manualmente por
# rota/oferta no painel do Clube Hurb, um unico HURB_TRACKED_LINK global nao
# cobre todas as ofertas do site. Esta variavel aceita um JSON (objeto plano,
# em UMA linha) mapeando "offerId" ou rota "ORIGEM-DESTINO" (maiusculas) para
# o link ja traqueado correspondente. HURB_TRACKED_LINK continua funcionando
# normalmente como fallback global quando nenhuma entrada especifica bate.
# Ex.: {"GRU-LIS":"https://www.clubehu.com.br/go/rota1","oferta-123":"https://www.clubehu.com.br/go/oferta123"}
HURB_TRACKED_LINKS_JSON=

# -----------------------------------------------------------------------------
# PARCEIROS PROMO / PASSAGENS PROMO (grupo Amo Promo)
# NAO HA API PUBLICA. Cadastre-se em https://www.parceirospromo.com.br/,
# aguarde aprovacao (nao garantida) e, apos aprovado, voce recebe por e-mail
# um codigo de afiliado (FRANQ) e acesso ao Portal do Afiliado, onde o link
# exclusivo de divulgacao e gerado manualmente. Cole aqui o link ja gerado no
# portal (o modulo apenas repassa esse link; ele NAO gera links novos).
# -----------------------------------------------------------------------------
PASSAGENS_PROMO_TRACKED_LINK=

# PASSAGENS_PROMO_TRACKED_LINKS_JSON (opcional): mesmo mecanismo do Hurb
# acima, para os links gerados manualmente no Portal do Afiliado da Parceiros
# Promo. JSON (objeto plano, em UMA linha) mapeando "offerId" ou rota
# "ORIGEM-DESTINO" (maiusculas) para o link ja traqueado. PASSAGENS_PROMO_TRACKED_LINK
# continua funcionando como fallback global.
# Ex.: {"GRU-LIS":"https://www.parceirospromo.com.br/go/rota1","offerId-custom":"https://www.parceirospromo.com.br/go/link2"}
PASSAGENS_PROMO_TRACKED_LINKS_JSON=

# -----------------------------------------------------------------------------
# GOOGLE MAPS PLATFORM (Places API New) — gerador de roteiros de viagem
# Usada por src/guides/ (buildItinerary/searchPlaces) para buscar pontos
# turisticos reais. Ver docs/PESQUISA-GOOGLE.md (secao 2).
#
# Onde obter: crie a chave em https://console.cloud.google.com/ (APIs e
# Servicos -> Credenciais -> Criar chave de API) e ATIVE a "Places API (New)"
# no projeto. Criar a chave e gratuito; para efetivamente FAZER chamadas de
# producao e obrigatorio ter uma CONTA DE BILLING (cartao) ativa no projeto.
#
# Custo: desde mar/2025 o Google usa cota gratuita mensal POR SKU (nao mais o
# credito unico de US$200). O caso de uso do gerador pede rating +
# editorialSummary, que caem no SKU mais caro (Text Search Enterprise +
# Atmosphere; ~1.000 chamadas gratis/mes nesse tier). Acompanhe o consumo no
# console e considere um FieldMask enxuto (option `fields` de searchPlaces)
# para reduzir custo. Politica: nao cachear os dados retornados (exceto place
# id) — o cliente ja desliga o cache para essas chamadas.
# -----------------------------------------------------------------------------
GOOGLE_MAPS_API_KEY=

# ATENDIMENTO
# AONDE_WHATSAPP: numero movel REAL de WhatsApp Business, formato internacional
# so com digitos (ex.: 5511999998888). VAZIO por padrao — sem numero, o site NAO
# promete WhatsApp: usa so o telefone abaixo por voz. NUNCA use o 0800 aqui: 0800
# e linha fixa e nao recebe WhatsApp. Com o numero setado, os CTAs "Fale no
# WhatsApp" viram links wa.me reais.
AONDE_WHATSAPP=
# AONDE_TELEFONE: telefone de atendimento por voz exibido no site (default 0800).
AONDE_TELEFONE=

# SEO / SEGURANCA
# AONDE_SITE_URL: URL base do site (para o sitemap.xml). Default https://aonde.com.br
AONDE_SITE_URL=
# AONDE_ADMIN_TOKEN: token de curadoria interna. Quando definido, requisicoes a
# GET /api/offers com o header "x-admin-token: <valor>" veem TODAS as ofertas
# (inclusive rascunhos). Sem o token, a API publica so retorna ofertas publicadas.
AONDE_ADMIN_TOKEN=

# -----------------------------------------------------------------------------
# AMADEUS SELF-SERVICE — preco tipico de rota + busca de voos AO VIVO
# As MESMAS credenciais abaixo habilitam duas coisas:
#   1. getTypicalPrices (src/partners/amadeus.js) — Flight Price Analysis API,
#      usada como fallback de media de rota do monitor (--media-fallback
#      amadeus). Ver docs/PESQUISA-PARCEIROS.md (secao Amadeus).
#   2. buscarVoosAoVivo (src/flights/buscarVoos.js) — Flight Offers Search,
#      usada por GET /resultados. Com as credenciais presentes, a tela de
#      resultados busca voos DE VERDADE (preco, horario, cia, paradas) para a
#      rota/data pesquisada. SEM credenciais (o caso comum ainda hoje), ou se
#      a Amadeus falhar/demorar/timeout, a tela cai para os mesmos voos de
#      EXEMPLO de sempre (src/render/aondeContent.js) — nunca quebra, nunca demora, e
#      nunca rotula exemplo como real.
#
# Onde obter: crie uma conta gratuita em https://developers.amadeus.com/
# (Self-Service), registre um app e copie a "API Key" (client_id) e o
# "API Secret" (client_secret). O tier gratuito ja cobre as duas APIs acima
# tanto no ambiente de teste quanto em producao (cota mensal gratuita; acima
# disso ha cobranca por chamada — a cota exata nao pode ser confirmada nesta
# doc, ver ressalva "a-validar" em src/partners/amadeus.js).
#
# AMADEUS_ENV seleciona a base URL:
#   test        -> https://test.api.amadeus.com  (sandbox; DEFAULT quando em branco)
#   production  -> https://api.amadeus.com
# Atencao: as credenciais de teste e de producao sao DIFERENTES no painel da
# Amadeus — use o par correspondente ao AMADEUS_ENV escolhido. O sandbox de
# teste cobre um conjunto limitado de rotas/datas com dados simulados — para
# ver voos reais de qualquer rota, use AMADEUS_ENV=production.
# -----------------------------------------------------------------------------
AMADEUS_CLIENT_ID=
AMADEUS_CLIENT_SECRET=
# AMADEUS_ENV=test

# AMADEUS_SEARCH_TIMEOUT_MS: teto de tempo (ms) para CADA chamada HTTP da
# busca ao vivo (token OAuth2 + Flight Offers Search), usado por
# src/flights/buscarVoos.js. Se a Amadeus nao responder dentro desse prazo, a
# tela de resultados cai no fallback de exemplo em vez de deixar a pessoa
# esperando. DEFAULT quando em branco: 3000 (3s). Baixar deixa o fallback mais
# agressivo (menos chance de mostrar voo real, mas pagina sempre rapida);
# subir da mais chance de sucesso da busca real, ao custo de paginas mais
# lentas quando a Amadeus estiver lenta.
# AMADEUS_SEARCH_TIMEOUT_MS=3000

# AMADEUS_SEARCH_MAX_RESULTS: quantos voos (os mais baratos primeiro) a tela
# de resultados mostra quando a busca ao vivo funciona. DEFAULT quando em
# branco: 6 (proximo dos 5 voos de exemplo de hoje). Teto absoluto: 20.
# AMADEUS_SEARCH_MAX_RESULTS=6

# =============================================================================
# ROBUSTEZ (opcional) — controle de rate limiting e cache da camada HTTP.
# Ver a secao "Robustez" do README.md. Deixe em branco/comentado para usar os
# defaults (rate limiting ligado; cache de 15 min apenas para a Data API).
# =============================================================================

# AONDE_RATE_LIMIT: defina como "off" para desligar o rate limiting client-side
# (token bucket por processo). Qualquer outro valor (ou em branco) mantem ligado.
# Limites default: Data API 200 req/h, /links 100 req/min, Awin 20 req/min,
# Amadeus 10 req/s.
# AONDE_RATE_LIMIT=

# AONDE_CACHE_TTL_MS: TTL (em ms) do cache em memoria das respostas GET da Data
# API (api.travelpayouts.com/aviasales/). Default: 900000 (15 min). Use 0 para
# DESLIGAR o cache por completo.
# AONDE_CACHE_TTL_MS=

# =============================================================================
# CURADORIA (opcional) — historico de precos, job de monitoramento e API REST.
# Ver a secao "Curadoria: historico, monitoramento e API" do README.md.
# =============================================================================

# AONDE_DATA_DIR: diretorio onde ficam os dados persistidos (historico de precos
# por rota, ofertas em rascunho e log de cliques). Default: "aonde-affiliates/data/"
# (relativo a raiz do modulo). Esse diretorio esta no .gitignore da raiz — nao
# faca commit dos dados.
# AONDE_DATA_DIR=

# AONDE_PORT: porta da API REST (scripts/serve.js). Default: 3333.
# AONDE_PORT=

# AONDE_CORS_ORIGIN: se definido, habilita CORS na API REST liberando essa
# origem (ex.: https://aonde.com.br). Ausente/em branco = nenhum header CORS.
# AONDE_CORS_ORIGIN=

# AONDE_INBOUND_RATE_LIMIT_WINDOW_MS / AONDE_INBOUND_RATE_LIMIT_MAX: rate
# limiting INBOUND por IP (janela fixa, em memoria) aplicado apenas aos
# endpoints POST publicos de escrita (subscribe/unsubscribe da newsletter,
# criar alerta, registrar clique de saida). Nao afeta GETs de pagina/leitura.
# Defaults: janela de 60000 ms (1 min), maximo de 20 requisicoes por IP por
# rota dentro da janela. Ver src/inboundRateLimiter.js.
# AONDE_INBOUND_RATE_LIMIT_WINDOW_MS=
# AONDE_INBOUND_RATE_LIMIT_MAX=

# AONDE_INBOUND_RATE_LIMIT_DISABLED: "1" desliga por completo o rate limiting
# inbound acima (util em dev/teste de carga). NUNCA habilitar em producao.
# AONDE_INBOUND_RATE_LIMIT_DISABLED=

# =============================================================================
# NEWSLETTER E ALERTAS DE PRECO (LGPD) — double opt-in.
# Ver a secao "Newsletter e alertas de preco (LGPD)" do README.md.
# =============================================================================

# AONDE_DEV_LOG_OPTIN: SOMENTE DESENVOLVIMENTO. Quando "1", o servidor loga no
# console a URL de confirmacao de opt-in (/api/newsletter/confirm?token=...) a
# cada inscricao — util para testar o fluxo sem um provedor de e-mail.
# NUNCA habilite em producao: o token no log da acesso direto a confirmacao do
# consentimento. Em producao o token vai apenas por e-mail, jamais em log ou na
# resposta HTTP. Ausente/em branco = desligado.
# AONDE_DEV_LOG_OPTIN=
